        outputs: [{id: 'Q', name: 'Q', net: 'captured', x: 112, y: 44}],
        cell: {
          type: 'DFF', id: 'U1',
          inputs: {D: 'capture_data', CLK: 'clk'}
        }
      },
      {
        id: 'captured', type: 'OUTPUT', label: 'captured',
