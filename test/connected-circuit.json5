        outputs: [{id: 'OUT', name: 'OUT', net: 'enable', x: 80, y: 16}]
      },
      {
        id: 'valid', type: 'INPUT', label: 'valid',
        x: 20, y: 84, width: 80, height: 32,
        inputs: [],
